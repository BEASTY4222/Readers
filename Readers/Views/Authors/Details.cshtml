@model Readers.Web.ViewModels.AuthorViewModels.AuthorDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}

@section Styles {
    <link rel="stylesheet" href="~/css/AuthorsPage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/BooksPage.css" asp-append-version="true" />
}

<div class="authors-page">
    <div class="authors-container">

        <!-- Author Profile Header -->
        <div class="author-profile-header">
            <div class="author-profile-image-wrap">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="author-profile-image" />
                }
                else
                {
                    <div class="author-profile-placeholder">
                        @{
                            var initials = string.Concat(
                                Model.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .Take(2)
                                    .Select(p => p[0])
                            );
                        }
                        <span>@initials</span>
                    </div>
                }
            </div>
            
            <div class="author-profile-info">
                <h1 class="author-profile-name">@Model.Name</h1>
                
                @if (!string.IsNullOrEmpty(Model.Country))
                {
                    <p class="author-profile-country">📍 @Model.Country</p>
                }
                
                <div class="author-profile-stats">
                    <span class="stat-badge">@Model.TotalBooks Books on Readers</span>
                </div>

                <a asp-action="Index" class="btn-back-authors">
                    &larr; Back to all authors
                </a>
            </div>
        </div>

        <hr class="author-divider" />

        <!-- Author's Books Grid -->
        <div class="author-books-section">
            <h2 class="section-title">Books by @Model.Name</h2>

            @if (Model.Books.Count == 0)
            {
                <div class="empty-state">
                    <p>No books have been added for this author yet.</p>
                </div>
            }
            else
            {
                <div class="books-grid">
                    @foreach (var book in Model.Books)
                    {
                        <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id" class="book-card-link">
                            <article class="book-card">
                                <div class="book-cover-wrap">
                                    @if (!string.IsNullOrEmpty(book.CoverImagePath))
                                    {
                                        <img src="@book.CoverImagePath" alt="@book.Title cover" class="book-cover" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="book-cover book-cover-placeholder">
                                            <span>@book.Title</span>
                                        </div>
                                    }
                                </div>

                                <div class="book-info">
                                    <h3 class="book-title">@book.Title</h3>
                                    <p class="book-author">@book.YearPublished</p>

                                    <div class="book-footer">
                                        <span class="book-stat" title="Likes">
                                            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                                                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="currentColor" />
                                            </svg>
                                            <span>@book.LikeCount</span>
                                        </span>

                                        <span class="book-stat" title="Comments">
                                            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                                                <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z" fill="currentColor" />
                                            </svg>
                                            <span>@book.CommentCount</span>
                                        </span>
                                    </div>
                                </div>
                            </article>
                        </a>
                    }
                </div>
            }
        </div>

    </div>
</div>